PORT=3001
NODE_ENV=development

# Banco de dados
# Use um usuário dedicado com privilégios mínimos (SELECT, INSERT,
# UPDATE, DELETE) no schema da aplicação — nunca root em produção.
DB_HOST=localhost
DB_USER=coursehub_app
DB_PASSWORD=changeme
DB_NAME=coursehub_escola
# Banco isolado para `npm test`. Obrigatório quando NODE_ENV=test —
# o backend recusa iniciar se faltar ou se apontar para coursehub_escola.
DB_NAME_TEST=coursehub_test

# Autenticação
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=changeme
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS / links do frontend
# A porta NÃO fica hardcoded na API. CORS_ORIGIN e FRONTEND_URL precisam
# ser a origem exata do Vite. O Vite deste repo está pinado em 5173
# (strictPort). Se mudar a porta no vite.config, mude os dois valores
# juntos — senão o browser bloqueia cookies de sessão e e-mails apontam
# para o host errado.
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# E-mail (SMTP) — deixe em branco em dev para usar uma conta de teste
# automática (Ethereal). Preencha para usar um provedor real em produção.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CourseHub <no-reply@coursehub.local>

# Worker de notificações por e-mail (npm run worker:notifications)
# Kill switch: "false" pausa o consumo da fila sem precisar de deploy
# (reinicie o worker para a mudança valer).
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_ID=
NOTIFICATION_WORKER_BATCH_SIZE=25
NOTIFICATION_WORKER_POLL_INTERVAL_MS=5000
NOTIFICATION_WORKER_LEASE_MINUTES=5
NOTIFICATION_WORKER_MAX_ATTEMPTS=5
NOTIFICATION_WORKER_RETRY_DELAYS_MINUTES=5,30,120,720

# Gateway de pagamento
# "simulated": gateway falso embutido, único permitido em desenvolvimento/
#   testes/CI. server.js recusa iniciar se PAYMENT_GATEWAY=simulated
#   com NODE_ENV=production.
# Fora de NODE_ENV=test, PIX e boleto simulados geram um QR Code real
# e auto-aprovam em ~5s (o polling do aluno marca a fatura paga).
# Defina SIMULATED_PAYMENT_AUTO_APPROVE=false para deixar pending.
SIMULATED_PAYMENT_AUTO_APPROVE=true
SIMULATED_PAYMENT_AUTO_APPROVE_MS=5000
# "mercado_pago": gateway real. Ao ativá-lo, MERCADO_PAGO_ACCESS_TOKEN e
#   MERCADO_PAGO_WEBHOOK_SECRET passam a ser obrigatórios (server.js
#   também recusa iniciar sem eles).
PAYMENT_GATEWAY=simulated

# NUNCA COMMITAR CREDENCIAIS REAIS. Em desenvolvimento use somente as
# credenciais de teste/sandbox da sua própria conta Mercado Pago
# ("Suas integrações" -> aplicação -> Credenciais de teste). Se este
# arquivo .env chegou a conter um valor real por engano, rotacione a
# credencial no painel do Mercado Pago antes de continuar.

# Backend secret -- nunca exposto ao frontend, nunca logado.
# Usado para autenticar toda chamada à API do Mercado Pago (criar
# pagamento, consultar, reembolsar).
MERCADO_PAGO_ACCESS_TOKEN=

# Chave pública -- só seria necessária se o frontend viesse a usar o
# SDK de tokenização de cartão do Mercado Pago diretamente no
# navegador (Card Payment Brick / MercadoPago.js). O MVP atual
# (PIX) não precisa dela; deixe em branco até que cartão seja
# implementado. Se um dia for usada no Vite, o nome da env var
# correspondente é VITE_MERCADO_PAGO_PUBLIC_KEY -- nunca
# VITE_MERCADO_PAGO_ACCESS_TOKEN (o access token jamais entra no
# bundle do frontend).
MERCADO_PAGO_PUBLIC_KEY=

# Segredo usado para validar a assinatura (header x-signature) de
# cada webhook recebido em /api/webhooks/payments/mercado-pago.
# Gerado em "Suas integrações" -> aplicação -> Webhooks -> Configurar
# notificações -> revelar chave secreta. Sem isso, PAYMENT_GATEWAY=
# mercado_pago não inicia (ver server.js).
MERCADO_PAGO_WEBHOOK_SECRET=

# URL pública e HTTPS do backend (sem barra final), usada para montar
# a notification_url enviada ao criar cada pagamento (o Mercado Pago
# precisa alcançar essa URL para entregar o webhook). Em
# desenvolvimento local, deixe em branco -- sem uma URL pública
# alcançável pelo Mercado Pago, webhooks reais não chegam; use a rota
# de simulação (dev-only) descrita em docs/features/payment-gateway.md.
MERCADO_PAGO_WEBHOOK_URL=

# Worker de lembretes financeiros programados (npm run worker:reminders)
# Gera e processa invoice_collection_actions (lembrete antes do
# vencimento, aviso no vencimento, marcação de atraso, aviso de
# possível acréscimo, aviso de risco de bloqueio e o bloqueio em si).
# Kill switch: "false" pausa geração/processamento sem deploy
# (reinicie o worker para a mudança valer).
SCHEDULED_REMINDERS_WORKER_ENABLED=true
SCHEDULED_REMINDERS_WORKER_BATCH_SIZE=50
SCHEDULED_REMINDERS_WORKER_POLL_INTERVAL_MS=3600000

# Desligado por padrão de propósito: decide se o worker acima chega a
# bloquear matrícula (enrollments.status='locked') por atraso de 30
# dias, ou só avisa (lock_warning) sem bloquear. Ative só depois de
# confirmar que é a política desejada -- nem toda instituição quer
# bloqueio automático de matrícula.
ENABLE_ENROLLMENT_AUTO_LOCK=false

# Dados institucionais. A página "Fale conosco" só devolve os campos
# opcionais que estiverem preenchidos (CNPJ, telefone, endereço, site).
# Contratos, recibos e certificados usam legalName/CNPJ/signatário mesmo
# quando o campo público está vazio — com fachada de demonstração, nunca
# "[PREENCHER]". Troque pelos dados reais antes de operação comercial.
INSTITUTION_NAME=CourseHub
INSTITUTION_TRADE_NAME=CourseHub
INSTITUTION_LEGAL_NAME=CourseHub Educação Ltda.
INSTITUTION_SUPPORT_EMAIL=contato@coursehub.com
INSTITUTION_PHONE=119844667788
INSTITUTION_WHATSAPP=
INSTITUTION_BUSINESS_HOURS=Segunda a sexta, 9h às 18h
INSTITUTION_ADDRESS=Rua Augusta, 1492, Consolação, São Paulo, SP.
INSTITUTION_CNPJ=54.321.987/0001-75
INSTITUTION_WEBSITE_URL=
INSTITUTION_SIGNATORY_NAME=Helena Martins
INSTITUTION_SIGNATORY_ROLE=Diretora Acadêmica — CourseHub

# Reset automático da demonstração no logout
# Quando true, POST /api/auth/logout restaura DB_NAME a partir de
# DEMO_SNAPSHOT_DB. O usuário informado abaixo precisa de SELECT no snapshot
# e SELECT/INSERT/DELETE no banco ativo. Se omitido, usa DB_USER/DB_PASSWORD.
DEMO_RESET_ON_LOGOUT=false
DEMO_SNAPSHOT_DB=coursehub_escola_jornada
DEMO_RESET_DB_USER=
DEMO_RESET_DB_PASSWORD=
