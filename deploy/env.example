# Copie para a raiz do repositório como .env e preencha antes do
# primeiro `docker compose up`. O .env não entra no git.

# Origem pública do site, sem barra no final. O navegador e a API
# usam esse mesmo endereço: o nginx encaminha /api. Em https o cookie
# de sessão sai secure; em http://localhost ele permanece utilizável.
PUBLIC_ORIGIN=http://localhost

MYSQL_ROOT_PASSWORD=troque-esta-senha
DB_PASSWORD=troque-esta-senha-do-app

# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque-este-segredo

# A demo sobe com NODE_ENV=production. Esta flag é o que autoriza o
# Pix simulado nesse modo. Sem ela a API recusa iniciar.
PAYMENT_GATEWAY=simulated
DEMO_ALLOW_SIMULATED_GATEWAY=true
DEMO_RESET_ON_LOGOUT=true

# Os schemas sobem vazios. Importe o dump da jornada (banco ativo e
# snapshot) antes de apresentar. O reset no logout copia
# coursehub_escola_jornada para coursehub_escola.
